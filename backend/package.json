{
  "name": "@redline/backend",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "dev": "node ../scripts/check-env.js && tsx src/server.ts",
    "start": "node ../scripts/check-env.js && node dist/server.js",
    "test": "node --test dist/**/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "8.1.1",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.10.2",
    "@types/ws": "8.18.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
